# Optional. Where waitlist messages should be delivered.
# If none of the delivery options below are set, the form stays honest:
# it asks the parent to send the prefilled message via their own e-mail.

# Inbox that should receive waitlist messages (also used for mailto fallback).
CONTACT_EMAIL=

# Optional public copy of the contact address (footer / mailto only).
NEXT_PUBLIC_CONTACT_EMAIL=

# Preferred: POST the submission as JSON to a webhook
# (Make, Zapier, n8n, Formspark, Getform, …).
WAITLIST_WEBHOOK_URL=

# Optional Resend delivery to the inbox above (not a welcome mail to the parent).
# A parent-facing welkomstmail is still missing until this is wired separately.
RESEND_API_KEY=
RESEND_FROM=
